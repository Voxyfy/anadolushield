{
  "name": "@voxyfy/anadolushield",
  "version": "0.1.0",
  "description": "LLM API'lerine (OpenAI, Anthropic, Gemini) gönderilmeden önce Türkçe kişisel verileri (TCKN, VKN, IBAN, telefon, isim vb.) maskeleyen, KVKK riskini azaltan framework-bağımsız kütüphane (Node.js/TypeScript)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "kvkk",
    "kvkk uyum",
    "pii redaction",
    "pii masking",
    "veri maskeleme",
    "kişisel veri",
    "llm privacy",
    "openai",
    "anthropic",
    "tckn",
    "vkn",
    "iban",
    "turkey",
    "türkiye",
    "nodejs",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Voxyfy/anadolushield.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
