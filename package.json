{
  "name": "@voxyfy/anadolushield",
  "version": "1.1.0",
  "description": "OpenAI, Anthropic (Claude) ve Gemini gibi yapay zeka servislerine göndermeden önce TCKN, VKN, IBAN, telefon ve isim gibi kişisel verileri maskeleyen, KVKK uyum riskini azaltan Türkçe kişisel veri koruma kütüphanesi (Node.js/TypeScript)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "kvkk",
    "kvkk uyum",
    "kvkk uyumluluk",
    "kişisel verilerin korunması",
    "pii redaction",
    "pii masking",
    "veri maskeleme",
    "veri anonimleştirme",
    "kişisel veri",
    "yapay zeka güvenliği",
    "llm privacy",
    "llm güvenliği",
    "openai",
    "chatgpt",
    "anthropic",
    "claude",
    "gemini",
    "tckn",
    "tc kimlik no",
    "vkn",
    "vergi kimlik no",
    "iban",
    "kredi kartı maskeleme",
    "turkey",
    "türkiye",
    "nodejs",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Voxyfy/anadolushield.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
